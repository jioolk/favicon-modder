{
  "name": "favicon-modder",
  "version": "0.3.0",
  "description": "Redraw the page favicon through small mods: recolour the logo, put a shape behind it, fade idle tabs. A JSON config per user and a drop-in configurator UI.",
  "license": "MIT",
  "author": "jioolk",
  "homepage": "https://github.com/jioolk/favicon-modder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jioolk/favicon-modder.git"
  },
  "bugs": {
    "url": "https://github.com/jioolk/favicon-modder/issues"
  },
  "type": "module",
  "main": "./dist/favicon-modder.js",
  "module": "./src/favicon-modder.js",
  "browser": "./dist/favicon-modder.min.js",
  "unpkg": "./dist/favicon-modder.min.js",
  "jsdelivr": "./dist/favicon-modder.min.js",
  "exports": {
    ".": {
      "import": "./src/favicon-modder.js",
      "require": "./dist/favicon-modder.js"
    },
    "./ui": {
      "import": "./src/favicon-modder-ui.js",
      "require": "./dist/favicon-modder-ui.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "favicon",
    "tab",
    "icon",
    "environment",
    "recolor",
    "idle",
    "canvas",
    "svg",
    "configurator",
    "settings"
  ],
  "scripts": {
    "build": "bun scripts/build.js",
    "test": "bun test"
  }
}
